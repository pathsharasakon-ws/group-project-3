{
  "name": "occasion-client",
  "version": "1.0.0",
  "description": "OCCASION E-Commerce Client",
  "scripts": {
    "dev": "npx -y concurrently \"npx @tailwindcss/cli -i ./style.css -o ./output.css --watch\" \"npx -y live-server . --port=5500 --entry-file=index.html\"",
    "serve": "npx -y live-server . --port=5500",
    "build": "npx @tailwindcss/cli -i ./style.css -o ./output.css --minify"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}
